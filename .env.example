# ==============================================================================
# DRIP E-Commerce Application — Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Auth & Database)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public anonymous key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase secret service role key (SERVER ONLY - never expose to client!)
# Required for /api/admin/users and server-side user metadata updates
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. AI Stylist & Chat Providers
# ------------------------------------------------------------------------------
# Groq API Key for fast streaming inference (Primary Chat Strategy)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Gemini API Key (Secondary Chat Strategy Fallback)
GOOGLE_AI_KEY=your_google_ai_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Virtual Try-On (VTON) Engine Providers (Multi-Provider Fallback)
# ------------------------------------------------------------------------------
# HuggingFace Access Token for yisol/IDM-VTON Gradio Space
HF_TOKEN=hf_your_huggingface_token

# PiAPI Key for Kling AI Virtual Try-On
PIAPI_KEY=your_piapi_key_here

# Replicate API Token for viktorfa/leffa model
REPLICATE_API_TOKEN=r8_your_replicate_api_token

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway (Optional - runs in Mock mode if not configured)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
